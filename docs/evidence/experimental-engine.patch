diff --git a/src/menus/menuLaunchSeed.ts b/src/menus/menuLaunchSeed.ts
new file mode 100644
index 000000000..5177e1ca0
--- /dev/null
+++ b/src/menus/menuLaunchSeed.ts
@@ -0,0 +1,17 @@
+/** An authored new-game form may submit `seed`: blank means a fresh roll.
+ * Omitting the field preserves the engine's configured new-game seed.
+ * Keep this decision before world creation: changing a seed after chunks
+ * generate would leave a world containing two different maps.
+ */
+export function resolveMenuLaunchSeed(
+  params: Record<string, unknown>,
+  configured: () => number,
+  random: () => number = Date.now,
+): number {
+  if (!Object.hasOwn(params, 'seed')) return configured()
+  const value = params.seed
+  if (value === null || (typeof value === 'string' && value.trim() === '')) return random()
+  const seed = typeof value === 'number' || typeof value === 'string' ? Number(value) : NaN
+  if (!Number.isSafeInteger(seed)) throw new Error('Game seed must be a whole number, or blank for a random map.')
+  return seed
+}
diff --git a/tests/unit/MenuLaunchSeed.test.ts b/tests/unit/MenuLaunchSeed.test.ts
new file mode 100644
index 000000000..e0d8ac246
--- /dev/null
+++ b/tests/unit/MenuLaunchSeed.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it, vi } from 'vitest'
+import { resolveMenuLaunchSeed } from '@/menus/menuLaunchSeed'
+
+describe('authored menu launch seed', () => {
+  it('uses a submitted seed, including zero, without consulting settings', () => {
+    const configured = vi.fn(() => 999)
+    for (const [value, expected] of [[0, 0], ['0', 0], [' 42 ', 42], [-17, -17]] as const) {
+      expect(resolveMenuLaunchSeed({ seed: value }, configured)).toBe(expected)
+    }
+    expect(configured).not.toHaveBeenCalled()
+  })
+  it('blank explicitly requests randomness even with a fixed settings seed', () => {
+    const random = vi.fn().mockReturnValueOnce(101).mockReturnValueOnce(102).mockReturnValueOnce(103)
+    for (const [value, expected] of [['', 101], ['  ', 102], [null, 103]] as const) {
+      expect(resolveMenuLaunchSeed({ seed: value }, () => 42, random)).toBe(expected)
+    }
+  })
+  it('preserves settings for menus with no seed field', () => {
+    expect(resolveMenuLaunchSeed({ players: 4 }, () => 42)).toBe(42)
+  })
+  it.each([true, {}, [], 'not a seed', 'Infinity', 0.5, Number.MAX_SAFE_INTEGER + 1])('refuses invalid input %j before world creation', seed => {
+    expect(() => resolveMenuLaunchSeed({ seed }, () => 42)).toThrow('Game seed')
+  })
+})
diff --git a/tests/unit/EntityGenerationParts.test.ts b/tests/unit/EntityGenerationParts.test.ts
new file mode 100644
index 000000000..1713467b7
--- /dev/null
+++ b/tests/unit/EntityGenerationParts.test.ts
@@ -0,0 +1,45 @@
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { generateEntity, redrawPartsWithPlan, type EntityGenerationPlan, type EntityGenerationRequest } from '@/ai/providers/ChatGptEntityProvider'
+import { callChat } from '@/ai/aiHttpClient'
+
+vi.mock('@/ai/aiHttpClient', () => ({
+  assertChatReady: vi.fn(), assertImageReady: vi.fn(), callChat: vi.fn(),
+  callImage: vi.fn(async () => ({ data: [{ b64_json: 'fixture' }] })),
+}))
+
+const plan: EntityGenerationPlan = {
+  totalWidth: 6, totalHeight: 4,
+  parts: ['Hull', 'Turret', 'Antenna'].map((name, i) => ({
+    name, elementId: 9, boxX: i * 2, boxY: 0, boxW: 2, boxH: 2, isRoot: i === 0,
+  })),
+  joints: [1, 2].map(i => ({ partA: 0, partB: i, type: 'hinge', anchorAX: 0, anchorAY: 0, anchorBX: 0, anchorBY: 0 })),
+}
+const request = {
+  userPrompt: 'three-part tank', targetHeight: 4,
+  elements: [{ id: 9, name: 'STONE', color: [0.5, 0.5, 0.5, 1] }],
+  config: { conversation: {}, image: {} },
+} as EntityGenerationRequest
+
+beforeEach(() => {
+  vi.stubGlobal('Image', class {
+    naturalWidth = 1; naturalHeight = 1; crossOrigin = ''
+    onload: (() => void) | null = null
+    set src(_value: string) { queueMicrotask(() => this.onload?.()) }
+  })
+  vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockReturnValue({
+    drawImage() {},
+    getImageData: () => ({ width: 1, height: 1, data: new Uint8ClampedArray([128, 128, 128, 255]) }),
+  } as unknown as CanvasRenderingContext2D)
+  vi.mocked(callChat).mockResolvedValue({ choices: [{ message: { content: JSON.stringify(plan) } }] })
+})
+afterEach(() => { vi.restoreAllMocks(); vi.unstubAllGlobals() })
+
+it.each(['generate', 'redraw'] as const)('%s returns distinct body indices matching every joint endpoint', async mode => {
+  const result = mode === 'generate' ? await generateEntity(request) : await redrawPartsWithPlan(plan, request)
+  expect(result.bodies.map(b => b.bodyIndex)).toEqual([0, 1, 2])
+  for (const joint of result.joints) {
+    expect(result.bodies.find(b => b.bodyIndex === joint.bodyA)?.name).toBe('Hull')
+    expect(result.bodies.find(b => b.bodyIndex === joint.bodyB)?.name).toBe(plan.parts[joint.bodyB].name)
+  }
+  expect(result.bodies.every(b => b.pixels.length > 0)).toBe(true)
+})
